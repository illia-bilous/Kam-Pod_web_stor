rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleOf(data) {
      return data.keys().hasAny(['role'])
        ? data.role
        : (data.get('isAdmin', false) == true ? 'admin' : 'user');
    }

    function myRole() {
      return roleOf(userDoc());
    }

    // Email першим: працює навіть якщо users/{uid} ще без role: admin
    function isAdmin() {
      return signedIn() && (isAdminEmail() || myRole() == 'admin');
    }

    function isKazkar() {
      return signedIn() && (isAdminEmail() || myRole() == 'kazkar' || myRole() == 'admin');
    }

    function isActive() {
      return signedIn() && userDoc().get('status', 'active') != 'blocked';
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'kn1b24.kushnir@kpnu.edu.ua',
          'fkola821@gmail.com'
        ];
    }

    // ----- users -----
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.status == 'active'
        && (
          (request.resource.data.role == 'user' && request.resource.data.get('isAdmin', false) == false)
          || (request.resource.data.role == 'kazkar' && request.resource.data.get('isAdmin', false) == false)
          || (request.resource.data.role == 'admin' && isAdminEmail())
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == roleOf(resource.data)
        && request.resource.data.status == resource.data.get('status', 'active')
        && request.resource.data.get('isAdmin', false) == (roleOf(resource.data) == 'admin');

      allow update, delete: if isAdmin();

      // ----- users/{userId}/questProgress (прогрес проходження квестів) -----
      // Без цього блоку markPartCompleted() у progressData.js падав з permission-denied,
      // і нагорода (XP/монети) ніколи не нараховувалась.
      match /questProgress/{questId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      // ----- users/{userId}/manualAchievements (ачивки, видані адміном вручну) -----
      match /manualAchievements/{achievementId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }

      // ----- users/{userId}/achievementProgress (коли розблоковано/переглянуто) -----
      match /achievementProgress/{achievementId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ----- quests (спільна колекція) -----
    // quests/{questId} — authorId у полях документа
    match /quests/{questId} {
      allow read: if signedIn() && (
        resource.data.status == 'published'
        || resource.data.authorId == request.auth.uid
        || isAdmin()
      );

      allow create: if isKazkar()
        && isActive()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.id == questId
        && (
          request.resource.data.status in ['draft', 'pending_review']
          || (isAdmin() && request.resource.data.status == 'published')
        );

      // Казкар: свої квести, без прямої публікації
      allow update: if isKazkar()
        && isActive()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.id == resource.data.id
        && request.resource.data.status in ['draft', 'pending_review', 'rejected', 'archived']
        && request.resource.data.status != 'published';

      // Адмін: погодити / відхилити / будь-яка правка (включно з прямою публікацією)
      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (
          isKazkar()
          && resource.data.authorId == request.auth.uid
          && resource.data.status == 'draft'
        );
    }

    // ----- invite codes (казкар) -----
    match /inviteCodes/{code} {
      allow read: if signedIn();

      allow update: if signedIn()
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.maxUses == resource.data.maxUses
        && request.resource.data.usedCount == resource.data.usedCount + 1;

      allow create, delete: if isAdmin();
    }

    // ----- activityLog (стрічка активності на адмін-дашборді) -----
    match /activityLog/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ----- achievements (визначення ачивментів, створює адмін) -----
    match /achievements/{achievementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ----- news (новини на Головній, створює адмін) -----
    match /news/{newsId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
