rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleOf(data) {
      return data.keys().hasAny(['role'])
        ? data.role
        : (data.get('isAdmin', false) == true ? 'admin' : 'user');
    }

    function myRole() {
      return roleOf(userDoc());
    }

    // Email ╨┐╨╡╤А╤И╨╕╨╝: ╨┐╤А╨░╤Ж╤О╤Ф ╨╜╨░╨▓╤Ц╤В╤М ╤П╨║╤Й╨╛ users/{uid} ╤Й╨╡ ╨▒╨╡╨╖ role: admin
    function isAdmin() {
      return signedIn() && (isAdminEmail() || myRole() == 'admin');
    }

    function isKazkar() {
      return signedIn() && (myRole() == 'kazkar' || myRole() == 'admin');
    }

    function isActive() {
      return signedIn() && userDoc().get('status', 'active') != 'blocked';
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email == 'kn1b24.kushnir@kpnu.edu.ua';
    }

    // ----- users -----
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.status == 'active'
        && (
          (request.resource.data.role == 'user' && request.resource.data.get('isAdmin', false) == false)
          || (request.resource.data.role == 'kazkar' && request.resource.data.get('isAdmin', false) == false)
          || (request.resource.data.role == 'admin' && isAdminEmail())
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == roleOf(resource.data)
        && request.resource.data.status == resource.data.get('status', 'active')
        && request.resource.data.get('isAdmin', false) == (roleOf(resource.data) == 'admin');

      allow update, delete: if isAdmin();

      // ----- users/{userId}/questProgress (╨┐╤А╨╛╨│╤А╨╡╤Б ╨┐╤А╨╛╤Е╨╛╨┤╨╢╨╡╨╜╨╜╤П ╨║╨▓╨╡╤Б╤В╤Ц╨▓) -----
      // ╨С╨╡╨╖ ╤Ж╤М╨╛╨│╨╛ ╨▒╨╗╨╛╨║╤Г markPartCompleted() ╤Г progressData.js ╨┐╨░╨┤╨░╨▓ ╨╖ permission-denied,
      // ╤Ц ╨╜╨░╨│╨╛╤А╨╛╨┤╨░ (XP/╨╝╨╛╨╜╨╡╤В╨╕) ╨╜╤Ц╨║╨╛╨╗╨╕ ╨╜╨╡ ╨╜╨░╤А╨░╤Е╨╛╨▓╤Г╨▓╨░╨╗╨░╤Б╤М.
      match /questProgress/{questId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      // ----- users/{userId}/manualAchievements (╨░╤З╨╕╨▓╨║╨╕, ╨▓╨╕╨┤╨░╨╜╤Ц ╨░╨┤╨╝╤Ц╨╜╨╛╨╝ ╨▓╤А╤Г╤З╨╜╤Г) -----
      match /manualAchievements/{achievementId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }

      // ----- users/{userId}/achievementProgress (╨║╨╛╨╗╨╕ ╤А╨╛╨╖╨▒╨╗╨╛╨║╨╛╨▓╨░╨╜╨╛/╨┐╨╡╤А╨╡╨│╨╗╤П╨╜╤Г╤В╨╛) -----
      match /achievementProgress/{achievementId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ----- quests (╤Б╨┐╤Ц╨╗╤М╨╜╨░ ╨║╨╛╨╗╨╡╨║╤Ж╤Ц╤П) -----
    // quests/{questId} тАФ authorId ╤Г ╨┐╨╛╨╗╤П╤Е ╨┤╨╛╨║╤Г╨╝╨╡╨╜╤В╨░
    match /quests/{questId} {
      allow read: if signedIn() && (
        resource.data.status == 'published'
        || resource.data.authorId == request.auth.uid
        || isAdmin()
      );

      allow create: if isKazkar()
        && isActive()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.id == questId
        && request.resource.data.status in ['draft', 'pending_review'];

      // ╨Ъ╨░╨╖╨║╨░╤А: ╤Б╨▓╨╛╤Ч ╨║╨▓╨╡╤Б╤В╨╕, ╨▒╨╡╨╖ ╨┐╤А╤П╨╝╨╛╤Ч ╨┐╤Г╨▒╨╗╤Ц╨║╨░╤Ж╤Ц╤Ч
      allow update: if isKazkar()
        && isActive()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.id == resource.data.id
        && request.resource.data.status in ['draft', 'pending_review', 'rejected', 'archived']
        && request.resource.data.status != 'published';

      // ╨Р╨┤╨╝╤Ц╨╜: ╨┐╨╛╨│╨╛╨┤╨╕╤В╨╕ / ╨▓╤Ц╨┤╤Е╨╕╨╗╨╕╤В╨╕ / ╨▒╤Г╨┤╤М-╤П╨║╨░ ╨┐╤А╨░╨▓╨║╨░ (╨▓╨║╨╗╤О╤З╨╜╨╛ ╨╖ ╨┐╤А╤П╨╝╨╛╤О ╨┐╤Г╨▒╨╗╤Ц╨║╨░╤Ж╤Ц╤Ф╤О)
      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (
          isKazkar()
          && resource.data.authorId == request.auth.uid
          && resource.data.status == 'draft'
        );
    }

    // ----- invite codes (╨║╨░╨╖╨║╨░╤А) -----
    match /inviteCodes/{code} {
      allow read: if signedIn();

      allow update: if signedIn()
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.maxUses == resource.data.maxUses
        && request.resource.data.usedCount == resource.data.usedCount + 1;

      allow create, delete: if isAdmin();
    }

    // ----- activityLog (╤Б╤В╤А╤Ц╤З╨║╨░ ╨░╨║╤В╨╕╨▓╨╜╨╛╤Б╤В╤Ц ╨╜╨░ ╨░╨┤╨╝╤Ц╨╜-╨┤╨░╤И╨▒╨╛╤А╨┤╤Ц) -----
    match /activityLog/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ----- achievements (╨▓╨╕╨╖╨╜╨░╤З╨╡╨╜╨╜╤П ╨░╤З╨╕╨▓╨╝╨╡╨╜╤В╤Ц╨▓, ╤Б╤В╨▓╨╛╤А╤О╤Ф ╨░╨┤╨╝╤Ц╨╜) -----
    match /achievements/{achievementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ----- news (╨╜╨╛╨▓╨╕╨╜╨╕ ╨╜╨░ ╨У╨╛╨╗╨╛╨▓╨╜╤Ц╨╣, ╤Б╤В╨▓╨╛╤А╤О╤Ф ╨░╨┤╨╝╤Ц╨╜) -----
    match /news/{newsId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
